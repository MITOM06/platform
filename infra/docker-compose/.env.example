# ============================================================================
# PON self-host — single deployment = single company.
# Copy to .env (cd infra/docker-compose && ./bootstrap.sh), fill the HUMAN
# section, leave the AUTO-GENERATED section blank (bootstrap.sh fills it).
# ============================================================================

# ---------- HUMAN MUST SET ----------
# Public hostname. Real DNS A-record -> this host gives automatic HTTPS.
# Use "localhost" for a local test (browser will warn on Caddy's internal CA).
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# First-boot seeding (auth-service bootstrap.service).
WORKSPACE_NAME=Acme Inc
BOOTSTRAP_OWNER_EMAIL=owner@acme.com

# AI (required for the assistant to run). Get from console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional connector OAuth apps (leave blank to hide those connectors).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_MCP_URL=https://mcp.notion.com/sse
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional outbound mail (OTP/password reset). Leave blank to disable.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Embeddings provider for RAG / memory — Voyage AI (Anthropic's recommended
# partner). Unset = RAG & long-term memory disabled (chat still works).
VOYAGE_API_KEY=

# Optional enterprise SSO (OpenID Connect). Leave OIDC_ENABLED blank to disable.
# Redirect URI to register at the IdP: https://${DOMAIN}/api/auth/oidc/callback
OIDC_ENABLED=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile groups
OIDC_GROUPS_CLAIM=groups

# Calls: "mesh" (peer-to-peer, the default) or "sfu" (through LiveKit — works
# behind 4G / corporate NAT). Meetings always use LiveKit. Needs DNS for
# rtc.${DOMAIN} and the firewall ports in docs/superpowers/runbooks/self-host.md.
CALL_TRANSPORT=

# Client IP behind the reverse proxy (auth-service rate limiting). Caddy in this
# stack is the public edge, so the default TRUST_PROXY=1 is right. Raise it to the
# number of proxies in front of auth-service if you put a load balancer before
# Caddy. Set CLIENT_IP_HEADER only behind a proxy that sets AND overwrites that
# header for every request (Cloudflare: cf-connecting-ip); otherwise leave blank.
TRUST_PROXY=1
CLIENT_IP_HEADER=

# ---------- AUTO-GENERATED (leave blank; bootstrap.sh fills these) ----------
# JWT signing secret — MUST be identical across all services (it is, via this file).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# auth-service session secret; the 2FA (TOTP) encryption key is derived from it.
# Never change it after go-live: every 2FA enrollment would have to be redone.
SESSION_SECRET=
# AES-256-GCM token vault key (base64 -> exactly 32 bytes).
CONNECTOR_VAULT_KEY=
# Shared secret for the internal tools API + OAuth state HMAC.
INTERNAL_API_KEY=
# LiveKit media server for calls and meetings — key name + signing secret,
# shared by the livekit container and chat-service.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Credentials for the bundled RabbitMQ. Generated per deployment — they used to
# be the hardcoded platform/platform, i.e. the local dev stack's credentials.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# ---------- DERIVED (do not edit; computed from DOMAIN) ----------
# connector-service OAuth plumbing routes through the proxy.
OAUTH_REDIRECT_BASE=https://${DOMAIN}/api/connector
CLIENT_REDIRECT_URL=https://${DOMAIN}/integrations
