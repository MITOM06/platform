# ============================================================================
# PON on a Mac mini — compute on the mini, data on the managed services.
#
#   cp .env.mini.example .env.mini
#   ...fill the sections below...
#   ../../scripts/mini/up.sh
#
# Every value here already exists as a GitHub Actions secret on this repo (it
# is what deploy.yml fed Cloud Run). Read them out with:
#   gh secret list
# GitHub cannot show a secret's value once set, so take them from wherever you
# originally stored them — Atlas / Upstash / CloudAMQP consoles re-issue theirs.
#
# .env.mini is gitignored. Never commit it.
# ============================================================================

# ---------- 1. MANAGED DATA TIER (required — nothing runs locally) ----------
# Exactly the values Cloud Run used; the mini reads and writes the same data.
# MongoDB Atlas.
MONGODB_URI=
# Upstash Redis — sessions and rotating refresh tokens. Wrong value here does
# not fail loudly, it signs everyone out.
REDIS_URL=
# CloudAMQP. Both forms are needed: chat-service (Spring) takes the parts,
# ai-service takes the whole URL.
RABBITMQ_HOST=
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# The *named* vhost CloudAMQP gave you — NOT '/'. Publishing into '/' reaches a
# vhost with no consumers and the assistant goes silent with no error anywhere.
RABBITMQ_VHOST=
RABBITMQ_URL=
# Qdrant Cloud — vector store for RAG and long-term memory. Blank = chat still
# works, knowledge base and memory do not.
QDRANT_URL=

# ---------- 2. SECRETS (must match the existing deployment) ----------
# Identical across all services. Change these and every issued token dies.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
# AES-256-GCM key for the connector token vault. This one is not just an auth
# secret: a different key makes every already-stored OAuth token undecryptable,
# and users have to reconnect every connector.
CONNECTOR_VAULT_KEY=
# Shared secret for the internal tools API + OAuth state HMAC.
INTERNAL_API_KEY=

# ---------- 3. AI ----------
ANTHROPIC_API_KEY=
# Embeddings for RAG / memory. Blank = those features off.
VOYAGE_API_KEY=
AI_BOT_DISPLAY_NAME=PON AI
AI_MONTHLY_TOKEN_LIMIT=500000

# ---------- 4. ADDRESSES ----------
# Where the web app runs. It stays on Vercel, so this does not change when the
# tunnel does. It is the whole CORS allow-list for all three NestJS services
# and chat-service — they refuse to boot without it.
WEB_ORIGIN=https://platform-web-omega-amber.vercel.app

# The public URL of THIS host. Left blank on purpose: scripts/mini/up.sh starts
# the tunnel, reads the assigned name and writes it back here. A quick tunnel
# gets a new name on every start — see the runbook for what that costs.
PON_API_BASE=

# ---------- 5. OPTIONAL INTEGRATIONS (blank = feature off) ----------
# Outbound mail — OTP and password reset. Blank means users cannot register.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Social login + the Google connector share one OAuth app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Notion connector.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_MCP_URL=https://mcp.notion.com/sse

# Push notifications (FCM), base64 of the service-account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Bot Factory bridge — the per-member personal assistant.
BOTFACTORY_BASE_URL=
BOTFACTORY_WORKER_TOKEN=

# ---------- 6. ROLLOUT ----------
# Which GHCR tag to run. `latest` is whatever CI last published from main; pin
# to a commit sha to roll back: IMAGE_TAG=<sha> ../../scripts/mini/up.sh
IMAGE_TAG=latest
