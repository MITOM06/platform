{
	# email for Let's Encrypt; auto-HTTPS when DOMAIN is a real hostname.
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	# Backend services — handle_path strips the matched prefix before proxying,
	# so each service keeps its existing routes (auth: /auth /me /admin; chat:
	# /api/...; connector: /oauth /connections /catalog).
	handle_path /api/auth/* {
		# The web app keeps its own cookie routes under the same prefix
		# (apps/web/app/api/auth/{set-cookie,session,refresh,clear-cookie}). Sending
		# them to auth-service 404'd every login, refresh and logout on a
		# single-domain install, so route those four back to Next.js.
		@webSession path /set-cookie /session /refresh /clear-cookie
		handle @webSession {
			rewrite * /api/auth{path}
			reverse_proxy web:3000
		}
		# handle_path strips /api/auth, so auth-service cannot tell what path the
		# browser used. It needs that to build the social-login redirect; without
		# it the redirect points at the host root and 404s before reaching Google.
		handle {
			reverse_proxy auth-service:3001 {
				header_up X-Forwarded-Prefix /api/auth
			}
		}
	}
	handle_path /api/connector/* {
		# /internal/* is for ai-service and chat-service over the Docker network
		# (INTERNAL_API_KEY). Never expose it publicly: a leaked key would then be
		# usable from the internet. handle_path already stripped /api/connector.
		@internal path /internal /internal/*
		respond @internal 404
		reverse_proxy connector-service:3003
	}
	handle_path /api/chat/* {
		reverse_proxy chat-service:8080
	}
	# Both clients call ai-service through this prefix when everything is behind
	# one domain (web: axios baseURL '/api/ai'; Flutter: AppConfig.aiBaseUrl ->
	# https://$DOMAIN/api/ai). Without the route those requests fell through to
	# the Next.js app and 404'd — the AI usage dashboard and session endpoints.
	handle_path /api/ai/* {
		reverse_proxy ai-service:3002
	}

	# STOMP WebSocket — keep the /ws path; Caddy proxies the upgrade transparently.
	handle /ws {
		reverse_proxy chat-service:8080
	}

	# Everything else → Next.js web app.
	handle {
		reverse_proxy web:3000
	}
}
