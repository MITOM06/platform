# ============================================================================
# Keycloak — production SSO for PON. Copy to .env.keycloak (gitignored) and
# fill every line. Runbook: docs/superpowers/runbooks/keycloak.md
# ============================================================================

# ---------- 1. ADDRESS ----------
# Public name of the IdP: the tunnel's second public hostname (Cloudflare Zero
# Trust → Networks → Tunnels → pon → Public Hostname → sso.<your domain>,
# Service HTTP → keycloak:8080). No scheme, no path.
SSO_DOMAIN=

# ---------- 2. SECRETS (generate; never reuse the dev values) ----------
# Temporary admin for the first login only — the runbook deletes it afterwards.
#   KC_BOOTSTRAP_ADMIN_PASSWORD: openssl rand -base64 24
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Keycloak's Postgres password: openssl rand -hex 24
KC_DB_PASSWORD=
# The pon-auth client secret: openssl rand -hex 32
# The SAME value goes into OIDC_CLIENT_SECRET in infra/docker-compose/.env.mini.
OIDC_CLIENT_SECRET=

# ---------- 3. PON ADDRESSES (copy from infra/docker-compose/.env.mini) ----------
# Used once, on the first import, for the client's redirect and logout URLs.
#   PON_API_BASE: the API hostname, e.g. https://api.example.com
#   WEB_ORIGIN:   the web app, e.g. https://app.example.com
PON_API_BASE=
WEB_ORIGIN=

# ---------- 4. MAIL ----------
# "Forgot password?" and email verification. The same SMTP account PON uses
# (MAIL_* in .env.mini) is fine. KC_SMTP_FROM is the sender address shown.
KC_SMTP_HOST=
KC_SMTP_PORT=587
KC_SMTP_USER=
KC_SMTP_PASSWORD=
KC_SMTP_FROM=
