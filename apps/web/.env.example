# apps/web environment — copy to .env.local (gitignored). No secrets here.
#
# Pick ONE of the two styles below; see apps/web/lib/config/env.ts.

# A. Whole backend behind one host (reverse proxy / tunnel / self-host).
#    Every base URL is derived: /api/auth, /api/chat, /api/ai, /api/connector,
#    and wss://<host>/ws. This is the mobile client's PON_DOMAIN model.
# NEXT_PUBLIC_API_BASE=https://api.example.com

# B. One host per service — the local stack, or split deployments. These win
#    over NEXT_PUBLIC_API_BASE, individually.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_CHAT_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_CONNECTOR_URL=http://localhost:3003
NEXT_PUBLIC_AI_URL=http://localhost:3002

# Set neither and the app calls /api/* on its own origin — correct only when a
# reverse proxy serves the web app and the API from the same host.

# Firebase Phone Auth (public web config — same values for all envs)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC8q9vgMzZYEPqEYcT1nRPb2JrWmd3XXwI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pon-c30fd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pon-c30fd
NEXT_PUBLIC_FIREBASE_APP_ID=1:246431845875:web:246c24ecc32054f798d686
