# Production build config for apps/web.
#
# NO BACKEND HOST LIVES HERE. This file used to pin the five NEXT_PUBLIC_*_URL
# variables to a set of Cloud Run URLs; the deployment moved and the file did
# not, so it sat in the repo looking authoritative while pointing at hosts that
# no longer exist. Anything platform-specific belongs to the platform:
#
#   Vercel        → NEXT_PUBLIC_API_BASE in Project Settings → Environment
#                   Variables (scripts/mini/up.sh prints the current value).
#   Self-host     → nothing to set. With no variable the app calls /api/* on its
#                   own origin, which is what Caddy serves.
#   Local dev     → apps/web/.env.development.local (scripts/dev/up.sh writes it).
#
# Precedence and the derived routes are documented in apps/web/lib/config/env.ts
# and docs/environments.md.

# Firebase Phone Auth — public web config, deliberately the same in every
# environment (one Firebase project). Kept here because a Vercel build has no
# other source for it: .env.local is gitignored.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC8q9vgMzZYEPqEYcT1nRPb2JrWmd3XXwI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pon-c30fd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pon-c30fd
NEXT_PUBLIC_FIREBASE_APP_ID=1:246431845875:web:246c24ecc32054f798d686
